{
	"name": "@nivalis/template",
	"description": "@nivalis/template",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/nivalis-studio/@nivalis/template#readme",
	"repository": {
		"url": "git+https://github.com/nivalis-studio/@nivalis/template.git"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "bun test",
		"build": "bunx zshy",
		"prepack": "bunx zshy",
		"prepare": "bunx lefthook install",
		"ts": "tsc --noEmit --incremental"
	},
	"dependencies": {},
	"peerDependencies": {
		"typescript": "^5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@nivalis/biome-config": "2.5.0",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/bun": "1.3.14",
		"@types/node": "24.2.0",
		"lefthook": "2.1.9",
		"taze": "19.14.1",
		"typescript": "5.9.3",
		"zshy": "0.7.3"
	},
	"zshy": "./src/index.ts",
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"types": "./dist/index.d.cts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	}
}
